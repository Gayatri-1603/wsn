import networkx as nx
import numpy as np
import random
from matplotlib.animation import FuncAnimation

# Configuration
N = 8
comm_radius = 0.4
source_id, dest_id = random.sample(range(N), 2)

# Create Random Graph
positions = {i: (random.random(), random.random()) for i in range(N)}
G = nx.Graph()
for i in range(N):
    for j in range(i + 1, N):
        d = np.linalg.norm(np.array(positions[i]) - np.array(positions[j]))
        if d < comm_radius:
            G.add_edge(i, j)

# Route Discovery (BFS)
parent = {source_id: None}
queue = [source_id]
found = False
while queue and not found:
    node = queue.pop(0)
    for neigh in G.neighbors(node):
        if neigh not in parent:
            parent[neigh] = node
            queue.append(neigh)
            if neigh == dest_id:
                found = True
                break

# Reconstruct path
path = []
if dest_id in parent:
    node = dest_id
    while node is not None:
        path.append(node)
        node = parent[node]
    path.reverse()

print(f"Source: {source_id}, Destination: {dest_id}")
print(f"Discovered route: {path}" if path else "No route found!")

# Visualization
